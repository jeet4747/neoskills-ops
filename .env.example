# NeoOps environment variables — copy to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# API port (defaults to 4000 if unset)
PORT=4000

# PostgreSQL connection string (Supabase). Required — without it the server
# starts in mock mode and every query fails.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?ssl=require

# Secret for signing JWTs. Required. Do NOT rely on the code's fallback value.
JWT_SECRET=change-me-to-a-long-random-string

# Web Push (optional) — generate with: npx web-push generate-vapid-keys
# Without these, browser push notifications silently do nothing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Currently unused by the code — safe to omit.
ADMIN_PASSWORD=
